<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4DA4278D"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:padding="6dp"
        android:text="Bench Press"
        android:textColor="#F9F72E"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Bench Press" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/weight_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="45"
                android:textColor="#FFFF00"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="45" />

            <TextView
                android:id="@+id/reps_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="8"
                android:textColor="#00FFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="8" />

            <TextView
                android:id="@+id/sets_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="4"
                android:textColor="#00FF00"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="4" />

            <TextView
                android:id="@+id/page_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#BDBDBD"
                android:textSize="11sp"
                tools:text="1 / 3" />
        </LinearLayout>

        <ImageView
            android:id="@+id/pie_chart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_pie_content_description"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_pie_preview" />
    </LinearLayout>

</LinearLayout>