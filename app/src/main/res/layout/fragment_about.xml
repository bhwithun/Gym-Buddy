<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AboutFragment">

    <ScrollView
        android:id="@+id/aboutScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/plate" />

                <TextView
                    android:id="@+id/appNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/app_name"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/versionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        tools:text="Version 8.8.2" />

                    <TextView
                        android:id="@+id/updateLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/update_install_link"
                        android:textColor="#00FFFF"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/creditsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#888888"
                        android:textSize="14sp"
                        tools:text="Made on Earth by Brian" />

                    <TextView
                        android:id="@+id/disconnectLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="@string/about_disconnect"
                        android:textColor="#00FFFF"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/profileStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/onSurface"
                android:textSize="16sp"
                tools:text="Connected to Brian" />

            <TextView
                android:id="@+id/setupBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_setup_body"
                android:textColor="@color/onSurfaceVariant"
                android:textSize="16sp" />

            <Button
                android:id="@+id/openSiteButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary"
                android:text="@string/about_open_site"
                android:textAllCaps="false"
                android:textColor="@color/onPrimary" />

            <Button
                android:id="@+id/scanProfileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/primary"
                android:text="@string/scan_profile"
                android:textAllCaps="false"
                android:textColor="@color/onPrimary" />

            <TextView
                android:id="@+id/manualToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:text="@string/about_manual"
                android:textColor="@color/weight_color"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/manualFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <EditText
                    android:id="@+id/workerUrlInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/worker_url_hint"
                    android:inputType="textUri"
                    android:textColor="@color/onSurface"
                    android:textColorHint="#888888"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/workerTokenInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/worker_token_hint"
                    android:inputType="textPassword"
                    android:textColor="@color/onSurface"
                    android:textColorHint="#888888"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/workerSaveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/primary"
                    android:text="@string/worker_save"
                    android:textAllCaps="false"
                    android:textColor="@color/onPrimary" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <WebView
        android:id="@+id/statsWeb"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:visibility="gone" />

    <TextView
        android:id="@+id/statsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="@string/about_stats_loading"
        android:textColor="@color/onSurfaceVariant"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
